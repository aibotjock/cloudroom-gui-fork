{
  "name": "bb",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "turbo run generate:templates generate:plugin-scaffold generate generate:bb-official-marketplace --filter=@cloudroom/templates --filter=@cloudroom/plugin-build --filter=@cloudroom/server --output-logs=errors-only --summarize=false",
    "scripts:prepare": "pnpm exec turbo run build --filter=@cloudroom/scripts --output-logs=none --log-prefix=none --summarize=false",
    "cli:prepare": "pnpm exec turbo run build --filter=@cloudroom/scripts --filter=@cloudroom/cli --output-logs=none --log-prefix=none --summarize=false",
    "ensure-native-modules": "node scripts/ensure-native-modules.mjs",
    "dev": "node scripts/ensure-native-modules.mjs && cross-env NODE_ENV=development dotenv -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-dev.ts",
    "start:worktree": "cross-env NODE_ENV=development dotenv -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-dev.ts --worktree",
    "start:worktree-remote": "cross-env BB_SERVER_BIND_HOST=0.0.0.0 pnpm run start:worktree",
    "dev:remote": "cross-env BB_DEV_APP_HOST=0.0.0.0 BB_SERVER_BIND_HOST=0.0.0.0 pnpm run dev",
    "dev:shared": "pnpm dev --shared",
    "dev:restart": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/request-dev-restart.ts both",
    "dev:restart-server": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/request-dev-restart.ts server",
    "dev:restart-host-daemon": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/request-dev-restart.ts host-daemon",
    "dev:host-daemon": "cross-env NODE_ENV=development dotenv -c development -- node --conditions=source --import tsx packages/scripts/src/commands/run-host-daemon.ts",
    "build": "turbo run build --filter=@cloudroom/scripts --filter=@cloudroom/app --filter=@cloudroom/server --filter=@cloudroom/host-daemon --filter=@cloudroom/cli --filter=bb-app",
    "bb-app:prepare": "turbo run build --filter=bb-app --output-logs=none --log-prefix=none --summarize=false",
    "start": "cross-env NODE_ENV=production dotenv -c production -- node --conditions=source --import tsx scripts/start-bb.mjs",
    "start:host-daemon": "cross-env NODE_ENV=production dotenv -c production -- pnpm run --silent bb-app:prepare && cross-env NODE_ENV=production dotenv -c production -- node packages/bb-app/dist/bb-app.js host-daemon",
    "seed:perf": "node scripts/ensure-native-modules.mjs && cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/seed-perf-db.ts",
    "parity": "pnpm --filter @cloudroom/provider-parity run parity",
    "reset": "cross-env NODE_ENV=production pnpm run --silent scripts:prepare && cross-env NODE_ENV=production node packages/scripts/dist/commands/reset-bb-data.js",
    "reset:dev": "cross-env NODE_ENV=development pnpm run --silent scripts:prepare && cross-env NODE_ENV=development node packages/scripts/dist/commands/reset-bb-data.js",
    "reset:all": "cross-env NODE_ENV=production pnpm run --silent scripts:prepare && cross-env NODE_ENV=production node packages/scripts/dist/commands/reset-bb-data.js --all",
    "clean": "turbo run clean",
    "codemod:remove-typescript-comments": "node scripts/remove-typescript-comments.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "storybook": "turbo run storybook --filter=@cloudroom/app",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "qa:standalone:start": "node tests/qa/scripts/run-root-command.mjs standalone:start",
    "qa:standalone:stop": "node tests/qa/scripts/run-root-command.mjs standalone:stop",
    "qa:standalone:cleanup": "node tests/qa/scripts/run-root-command.mjs standalone:cleanup",
    "codex:archive-tmp-bb-sessions": "pnpm run --silent scripts:prepare && node packages/scripts/dist/commands/archive-codex-tmp-bb-sessions.js",
    "room-cli": "cross-env NODE_ENV=production pnpm run --silent cli:prepare 1>&2 && cross-env NODE_ENV=production node packages/scripts/dist/commands/run-cli.js",
    "room:dev": "cross-env NODE_ENV=development node --conditions=source --import tsx packages/scripts/src/commands/run-cli.ts",
    "server": "pnpm --filter @cloudroom/server start",
    "drizzle-studio": "cross-env NODE_ENV=development pnpm --filter @cloudroom/db db:studio",
    "drizzle-studio:prod": "cross-env NODE_ENV=production pnpm --filter @cloudroom/db db:studio"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "esbuild": "0.25.0",
    "http-proxy-3": "^1.23.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "4.1.1"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    },
    "overrides": {
      "zod": "4.3.6",
      "@babel/core@7.29.0": "7.29.6",
      "@grpc/grpc-js@1.14.4": "1.14.5",
      "@hono/node-server@1.19.14": "1.19.15",
      "@modelcontextprotocol/sdk@1.29.0": "1.32.0",
      "baseline-browser-mapping@2.9.19": "2.11.0",
      "brace-expansion@1.1.18": "1.1.21",
      "brace-expansion@2.1.4": "2.1.7",
      "brace-expansion@5.0.7": "5.0.12",
      "brace-expansion@5.0.9": "5.0.12",
      "browserslist@4.28.1": "4.28.7",
      "builder-util-runtime@9.5.1": "9.7.0",
      "decode-uri-component@0.4.1": "0.5.0",
      "dompurify@3.4.8": "3.4.17",
      "dompurify@3.4.9": "3.4.17",
      "electron@44.3.0": "44.5.0",
      "fast-copy@4.0.2": "4.1.0",
      "fast-uri@3.1.3": "3.1.8",
      "follow-redirects@1.16.0": "1.16.1",
      "handlebars@4.7.8": "4.7.10",
      "hono@4.11.9": "4.13.11",
      "hono@4.12.28": "4.13.11",
      "http-cache-semantics@4.2.0": "4.3.0",
      "ip-address@10.2.0": "10.7.4",
      "js-yaml@3.14.2": "3.15.2",
      "js-yaml@4.1.1": "4.3.2",
      "katex@0.16.47": "0.18.2",
      "markdown-it@14.3.0": "14.3.3",
      "mermaid@11.15.0": "11.16.1",
      "nanoid@5.1.6": "5.1.16",
      "postcss@8.5.15": "8.5.23",
      "prosemirror-view@1.41.8": "1.42.3",
      "proxy-addr@2.0.7": "2.0.8",
      "qs@6.15.3": "6.16.0",
      "react-router@7.13.0": "7.18.2",
      "seroval@1.5.4": "1.6.3",
      "sharp@0.34.5": "0.35.5",
      "shell-quote@1.8.3": "1.11.0",
      "smol-toml@1.7.1": "1.9.0",
      "source-map-js@1.2.1": "1.2.2",
      "tinypool@2.1.0": "2.1.2",
      "undici@6.28.0": "6.28.1",
      "undici@7.28.0": "7.29.1",
      "undici@8.9.0": "8.10.2",
      "vite@6.4.1": "6.4.4",
      "vite@8.0.12": "8.1.6",
      "yaml@2.8.2": "2.8.3",
      "js-yaml@>=4 <5": "4.3.2",
      "vitest@>=3 <4": "3.2.6",
      "vitest@>=4 <5": "4.1.1",
      "@vue/server-renderer": "3.5.39",
      "@tanstack/react-start": "1.168.25",
      "@tanstack/start-server-core": "1.169.14",
      "esbuild@<0.25.0": "0.25.0"
    },
    "patchedDependencies": {
      "oniguruma-to-es@4.3.4": "patches/oniguruma-to-es@4.3.4.patch",
      "@pierre/diffs@1.2.9": "patches/@pierre__diffs@1.2.9.patch",
      "sonner@1.7.4": "patches/sonner@1.7.4.patch",
      "app-builder-lib@26.15.7": "patches/app-builder-lib@26.15.7.patch"
    }
  }
}
